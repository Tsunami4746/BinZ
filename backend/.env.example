# MongoDB
MONGO_URI=mongodb://localhost:27017/binzDB

# Server port
PORT=5000

# Twilio (used by POST /sendSMS — optional, pickup booking still works if these are blank)
twilioAccountSid=
twilioAuthToken=

# Gmail (used by POST /submit-ticket confirmation email — optional, ticket still gets created if this fails)
# Use a Gmail App Password, not your normal Gmail password.
EMAIL_USER=
EMAIL_PASS=
